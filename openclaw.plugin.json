{
  "id": "tg-stickers-chat",
  "name": "TG Stickers Chat",
  "description": "Intent-driven Telegram sticker chat enhancement for OpenClaw using Gemini Embedding 2 and local SQLite/in-memory retrieval",
  "version": "1.0.3",
  "contracts": {
    "tools": [
      "sync_sticker_set_by_name",
      "get_sticker_stats",
      "select_sticker_for_reply",
      "search_sticker_by_emotion"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "embeddingApiKey": {
        "type": "string",
        "description": "Gemini API key used for embedding calls"
      },
      "embeddingModel": {
        "type": "string",
        "default": "gemini-embedding-2-preview",
        "description": "Gemini embedding model used for sticker and query embeddings"
      },
      "embeddingDimensions": {
        "type": "integer",
        "default": 768,
        "minimum": 128,
        "maximum": 3072,
        "description": "Output dimensionality for embedding vectors"
      },
      "autoCollect": {
        "type": "boolean",
        "default": true,
        "description": "Whether to automatically queue newly seen Telegram sticker sets from incoming sticker traffic"
      }
    }
  },
  "uiHints": {
    "embeddingApiKey": {
      "label": "Gemini Embedding API Key",
      "sensitive": true
    },
    "embeddingModel": {
      "label": "Embedding Model Name",
      "placeholder": "gemini-embedding-2-preview"
    },
    "embeddingDimensions": {
      "label": "Embedding Dimensions"
    },
    "autoCollect": {
      "label": "Auto Collect New Sets"
    }
  }
}
