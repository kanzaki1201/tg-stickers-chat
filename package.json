{
  "name": "tg-stickers-chat",
  "version": "1.0.3",
  "description": "OpenClaw Telegram sticker chat enhancement plugin built around intent-driven sticker selection, Gemini Embedding 2, and local vector similarity search.",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "telegram",
    "stickers",
    "semantic-search",
    "gemini",
    "embedding",
    "sqlite",
    "vector-search"
  ],
  "author": "Mashiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MashiroCodfish/tg-stickers-chat.git"
  },
  "homepage": "https://github.com/MashiroCodfish/tg-stickers-chat#readme",
  "bugs": {
    "url": "https://github.com/MashiroCodfish/tg-stickers-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^12.11.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md",
    "docs/OPENCLAW_AUTO_INSTALL.md",
    "LICENSE",
    "package.json"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
